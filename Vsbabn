    topBar.BackgroundColor3 = Library.Colors.TOPBAR
    topBar.BorderSizePixel = 0
    createCorner(topBar, 12)
    
    -- Quadrado invisível para tapar o arredondamento de baixo da topbar
    local filler = Instance.new("Frame", topBar)
    filler.Size = UDim2.new(1, 0, 0, 10)
    filler.Position = UDim2.new(0, 0, 1, -10)
    filler.BackgroundColor3 = Library.Colors.TOPBAR
