-- [ FUNÇÕES AUXILIARES ] --
local function createCorner(obj, r)
    local c = Instance.new("UICorner", obj)
    c.CornerRadius = UDim.new(0, r or 10)
end

local function createStroke(obj, color, thickness)
    local s = Instance.new("UIStroke", obj)
    s.Color = color
    s.Thickness = thickness or 1.2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    table.insert(Library.ThemedElements, s)
    return s
end

local function makeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- [ SISTEMA DE TEMA ] --
function Library:SetTheme(color)
    self.Colors.NEON_ORANGE = color
    for _, obj in pairs(self.ThemedElements) do
        if obj:IsA("UIStroke") then
            obj.Color = color
        elseif obj:IsA("Frame") and obj.Name == "Fill" then
            obj.BackgroundColor3 = color
        elseif obj:IsA("TextLabel") and obj.Name == "Icon" then
            obj.TextColor3 = color
        elseif obj:IsA("ScrollingFrame") then
            obj.ScrollBarImageColor3 = color
        elseif obj:IsA("TextLabel") and obj.Name == "FPSLabel" then
            obj.TextColor3 = color
        end
    end
end

-- [ ANIMAÇÃO DO ÍCONE ✦ ] --
local function rotateIcon(label)
    task.spawn(function()
        while label and label.Parent do
            label.Rotation = label.Rotation + 3
            task.wait()
        end
    end)
end

-- [ SISTEMA DE NOTIFICAÇÃO ] --
function Library:Notify(title, text, duration)
    local parent = CoreGui:FindFirstChild("BitcodeLibrary")
    if not parent then return end

    local container = parent:FindFirstChild("NotifyContainer")
    if not container then
        container = Instance.new("Frame", parent)
        container.Name = "NotifyContainer"
        container.Size = UDim2.new(0, 260, 1, -20)
        container.Position = UDim2.new(1, -270, 0, 10)
        container.BackgroundTransparency = 1

        local layout = Instance.new("UIListLayout", container)
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.Padding = UDim.new(0, 8)
    end

    local frame = Instance.new("Frame", container)
    frame.Size = UDim2.new(1, 0, 0, 0)
    frame.BackgroundColor3 = self.Colors.BACKGROUND_BLACK
    frame.ClipsDescendants = true
    createCorner(frame, 8)

    local stroke = createStroke(frame, self.Colors.NEON_ORANGE, 1.2)

    local titleLabel = Instance.new("TextLabel", frame)
    titleLabel.Size = UDim2.new(1, -10, 0, 18)
    titleLabel.Position = UDim2.new(0, 8, 0, 4)
    titleLabel.Text = title
    titleLabel.TextColor3 = self.Colors.NEON_ORANGE
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 12
    titleLabel.BackgroundTransparency = 1
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local desc = Instance.new("TextLabel", frame)
    desc.Size = UDim2.new(1, -10, 0, 30)
    desc.Position = UDim2.new(0, 8, 0, 20)
    desc.Text = text
    desc.TextColor3 = self.Colors.ACCENT_WHITE
    desc.Font = Enum.Font.Gotham
    desc.TextSize = 11
    desc.BackgroundTransparency = 1
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Left

    -- Animação Entrada
    TweenService:Create(frame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 55)}):Play()

    task.delay(duration or 3, function()
        TweenService:Create(frame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 0)}):Play()
        task.wait(0.3)
        frame:Destroy()
    end)
end

