function Library:CreateTab(name)
    local btn = Instance.new("TextButton", self.TabList)
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.BackgroundColor3 = Library.Colors.DARK_GREY
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    createCorner(btn, 6)

    local content = Instance.new("ScrollingFrame", self.Container)
    content.Size = UDim2.new(1, 0, 1, 0)
    content.BackgroundTransparency = 1
    content.Visible = false
    content.ScrollBarThickness = 2
    content.ScrollBarImageColor3 = Library.Colors.NEON_ORANGE
    table.insert(Library.ThemedElements, content)
    
    Instance.new("UIListLayout", content).Padding = UDim.new(0, 8)

    btn.MouseButton1Click:Connect(function()
        for _, v in pairs(self.Container:GetChildren()) do v.Visible = false end
        content.Visible = true
        content.GroupTransparency = 1
        TweenService:Create(content, TweenInfo.new(0.3), {GroupTransparency = 0}):Play()
    end)

    if not self._firstTab then
        self._firstTab = true
        content.Visible = true
    end

    local tab = {}

    function tab:CreateButton(text, cb)
        local b = Instance.new("TextButton", content)
        b.Size = UDim2.new(0.95, 0, 0, 35)
        b.BackgroundColor3 = Library.Colors.DARK_GREY
        b.Text = text
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamSemibold
        createCorner(b, 6)
        
        -- Efeito Click & Hover
        b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Library.Colors.HIGHLIGHT}):Play() end)
        b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Library.Colors.DARK_GREY}):Play() end)
        b.MouseButton1Down:Connect(function() 
            b:TweenSize(UDim2.new(0.9, 0, 0, 32), "Out", "Quad", 0.1, true)
            cb()
            task.wait(0.1)
            b:TweenSize(UDim2.new(0.95, 0, 0, 35), "Out", "Quad", 0.1, true)
        end)
    end

    function tab:CreateToggle(text, cb)
        local s = false
        local tBtn = Instance.new("TextButton", content)
        tBtn.Size = UDim2.new(0.95, 0, 0, 35)
        tBtn.BackgroundColor3 = Library.Colors.DARK_GREY
        tBtn.Text = "  " .. text
        tBtn.TextXAlignment = Enum.TextXAlignment.Left
        tBtn.TextColor3 = Color3.new(1,1,1)
        createCorner(tBtn, 6)

        local box = Instance.new("Frame", tBtn)
        box.Size = UDim2.new(0, 35, 0, 18)
        box.Position = UDim2.new(1, -45, 0.5, -9)
        box.BackgroundColor3 = Color3.fromRGB(40,40,40)
        createCorner(box, 10)

        local dot = Instance.new("Frame", box)
        dot.Name = "Fill"
        dot.Size = UDim2.new(0, 14, 0, 14)
        dot.Position = UDim2.new(0, 2, 0.5, -7)
        dot.BackgroundColor3 = Library.Colors.NEON_ORANGE
        createCorner(dot, 10)
        table.insert(Library.ThemedElements, dot)

        tBtn.MouseButton1Click:Connect(function()
            s = not s
            TweenService:Create(dot, TweenInfo.new(0.2), {Position = s and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
            cb(s)
        end)
    end

    function tab:CreateDropdown(text, list, cb)
        local open = false
        local dFrame = Instance.new("Frame", content)
        dFrame.Size = UDim2.new(0.95, 0, 0, 35)
        dFrame.BackgroundColor3 = Library.Colors.DARK_GREY
        dFrame.ClipsDescendants = true
        createCorner(dFrame, 6)

        local dBtn = Instance.new("TextButton", dFrame)
        dBtn.Size = UDim2.new(1, 0, 0, 35)
        dBtn.Text = "  " .. text
        dBtn.TextXAlignment = Enum.TextXAlignment.Left
        dBtn.TextColor3 = Color3.new(1,1,1)
        dBtn.BackgroundTransparency = 1

        dBtn.MouseButton1Click:Connect(function()
            open = not open
            TweenService:Create(dFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {Size = open and UDim2.new(0.95, 0, 0, 35 + (#list * 25)) or UDim2.new(0.95, 0, 0, 35)}):Play()
        end)

        for _, item in pairs(list) do
            local it = Instance.new("TextButton", dFrame)
            it.Size = UDim2.new(1, 0, 0, 25)
            it.Position = UDim2.new(0, 0, 0, 35 + ((_ - 1) * 25))
            it.Text = item
            it.BackgroundColor3 = Color3.fromRGB(30,30,30)
            it.TextColor3 = Color3.new(0.8,0.8,0.8)
            it.BorderSizePixel = 0
            it.MouseButton1Click:Connect(function()
                cb(item)
                dBtn.Text = "  " .. text .. ": " .. item
                open = false
                TweenService:Create(dFrame, TweenInfo.new(0.3), {Size = UDim2.new(0.95, 0, 0, 35)}):Play()
            end)
        end
    end

    return tab
end

return Library
