-- FUNÇÕES UTILITÁRIAS
local function createCorner(obj, r)
    local c = Instance.new("UICorner", obj)
    c.CornerRadius = UDim.new(0, r or 12)
end

local function makeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- SISTEMA DE NOTIFICAÇÃO
function Library:Notify(title, text, duration)
    local notifyGui = CoreGui:FindFirstChild("BitcodeLibrary"):FindFirstChild("NotifyContainer")
    if not notifyGui then
        notifyGui = Instance.new("Frame", CoreGui:FindFirstChild("BitcodeLibrary"))
        notifyGui.Name = "NotifyContainer"
        notifyGui.Size = UDim2.new(0, 250, 1, 0)
        notifyGui.Position = UDim2.new(1, -260, 0, 0)
        notifyGui.BackgroundTransparency = 1
        local layout = Instance.new("UIListLayout", notifyGui)
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.Padding = UDim.new(0, 10)
    end

    local nFrame = Instance.new("Frame", notifyGui)
    nFrame.Size = UDim2.new(1, 0, 0, 0)
    nFrame.BackgroundColor3 = Library.Colors.BACKGROUND_BLACK
    nFrame.ClipsDescendants = true
    createCorner(nFrame, 8)
    
    local stroke = Instance.new("UIStroke", nFrame)
    stroke.Color = Library.Colors.NEON_ORANGE
    stroke.Thickness = 1.2

    local tLabel = Instance.new("TextLabel", nFrame)
    tLabel.Size = UDim2.new(1, -10, 0, 20)
    tLabel.Position = UDim2.new(0, 10, 0, 5)
    tLabel.Text = title:upper()
    tLabel.TextColor3 = Library.Colors.NEON_ORANGE
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextSize = 12
    tLabel.BackgroundTransparency = 1
    tLabel.TextXAlignment = Enum.TextXAlignment.Left

    local dLabel = Instance.new("TextLabel", nFrame)
    dLabel.Size = UDim2.new(1, -20, 0, 30)
    dLabel.Position = UDim2.new(0, 10, 0, 22)
    dLabel.Text = text
    dLabel.TextColor3 = Library.Colors.ACCENT_WHITE
    dLabel.Font = Enum.Font.Gotham
    dLabel.TextSize = 11
    dLabel.BackgroundTransparency = 1
    dLabel.TextWrapped = true
    dLabel.TextXAlignment = Enum.TextXAlignment.Left

    TweenService:Create(nFrame, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, 60)}):Play()
    
    task.delay(duration or 3, function()
        TweenService:Create(nFrame, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, 0)}):Play()
        task.wait(0.4)
        nFrame:Destroy()
    end)
end

